    <string name="tour_home_menu_body">长按空白处可打开自定义、隐藏应用和常见问题。</string>
    <string name="tour_folder_title">文件夹</string>
    <string name="tour_folder_body">从应用菜单选择“移至文件夹”。点击文件夹即可展开。</string>
    <string name="tour_gestures_title">滑动手势</string>
    <string name="tour_gestures_body">按设置中的方向滑动，即可执行你指定的操作。</string>
    <string name="tour_lock_title">双击锁屏</string>
