<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/settingsScrollView" android:layout_width="match_parent" android:layout_height="match_parent" android:fitsSystemWindows="true" android:background="@android:color/transparent">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="40dp">

        <!-- ── General ── -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="28dp" android:paddingTop="28dp" android:paddingBottom="24dp">

            <TextView android:id="@+id/labelGeneral" style="@style/SectionLabel" android:text="@string/ui_general"/>

            <!-- Double tap to lock screen -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="10dp">

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">

                    <TextView android:id="@+id/labelDoubleTap" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_double_tap_to_lock_screen" android:textSize="17sp"/>

                    <TextView android:id="@+id/labelDoubleTapSub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_requires_accessibility_service_permission" android:textSize="13sp" android:alpha="0.6"/>
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/switchDoubleTap" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>

            <!-- Sort by usage toggle -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="10dp">

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_sort_by_most_used" android:textSize="17sp"/>

                    <TextView android:id="@+id/labelSortByUsageSub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_most_launched_apps_appear_first" android:textSize="13sp" android:alpha="0.6"/>
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/switchSortByUsage" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>

            <!-- Most-used position remains visible, but disabled, when usage sorting is off. -->
            <LinearLayout android:id="@+id/rowMostUsedPosition" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="10dp" android:background="?attr/selectableItemBackground">

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_show_most_used_at" android:textSize="17sp"/>

                    <TextView android:id="@+id/labelMostUsedPositionSub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_turn_on_sort_by_most_used_to_enable" android:textSize="13sp" android:alpha="0.6"/>
                </LinearLayout>

                <TextView android:id="@+id/mostUsedPositionValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="14sp"/>
            </LinearLayout>

            <!-- Lock orientation toggle -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="10dp">

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_lock_screen_rotation" android:textSize="17sp"/>

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_keep_launcher_in_portrait" android:textSize="13sp" android:alpha="0.6"/>
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/switchLockOrientation" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>

            <!-- Status bar toggle -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="10dp">

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_hide_status_bar" android:textSize="17sp"/>

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_full_screen_launcher_swipe_down_to_peek" android:textSize="13sp" android:alpha="0.6"/>
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/switchHideStatusBar" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>

            <!-- Alphabetical fast scroll -->
            <LinearLayout android:id="@+id/rowAlphaFastScroll" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="10dp">

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_alphabetical_fast_scroll" android:textSize="17sp"/>

                    <TextView android:id="@+id/labelAlphaFastScrollSub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_side_index_to_jump_letters_sorts_a_z" android:textSize="13sp" android:alpha="0.6"/>
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/switchAlphaFastScroll" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>

            <!-- Default launcher row -->
            <LinearLayout android:id="@+id/rowDefaultLauncher" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="12dp" android:background="?attr/selectableItemBackground">

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">

                    <TextView android:id="@+id/labelDefaultLauncher" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_set_as_default_launcher" android:textSize="17sp"/>

                    <TextView android:id="@+id/labelDefaultLauncherSub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_open_system_launcher_picker" android:textSize="13sp" android:alpha="0.6"/>
                </LinearLayout>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="→" android:textSize="17sp"/>
            </LinearLayout>

        <LinearLayout android:id="@+id/rowLanguage" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="14dp" android:background="?attr/selectableItemBackground"><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/language" android:textSize="17sp"/></LinearLayout><TextView android:id="@+id/languageValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="15sp"/></LinearLayout></LinearLayout>

        <View android:id="@+id/divider0" android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="28dp" android:layout_marginEnd="28dp"/>

        <!-- ── Text Size ── -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="28dp" android:paddingTop="28dp" android:paddingBottom="24dp">

            <TextView android:id="@+id/labelTextSize" style="@style/SectionLabel" android:text="@string/ui_text_size"/>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="16dp">

                <TextView android:id="@+id/labelMaximum" android:layout_width="90dp" android:layout_height="wrap_content" android:text="@string/ui_maximum" android:textSize="17sp"/>

                <SeekBar android:id="@+id/maxFontSeekBar" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginHorizontal="12dp"/>

                <TextView android:id="@+id/maxFontLabel" android:layout_width="44dp" android:layout_height="wrap_content" android:textSize="16sp" android:gravity="end"/>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="16dp">

                <TextView android:id="@+id/labelLineSpacing" android:layout_width="90dp" android:layout_height="wrap_content" android:text="@string/ui_line_gap" android:textSize="17sp"/>

                <SeekBar android:id="@+id/lineSpacingSeekBar" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginHorizontal="12dp"/>

                <TextView android:id="@+id/lineSpacingLabel" android:layout_width="44dp" android:layout_height="wrap_content" android:textSize="16sp" android:gravity="end"/>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">

                <TextView android:id="@+id/labelWordSpacing" android:layout_width="90dp" android:layout_height="wrap_content" android:text="@string/ui_word_gap" android:textSize="17sp"/>

                <SeekBar android:id="@+id/wordSpacingSeekBar" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginHorizontal="12dp"/>

                <TextView android:id="@+id/wordSpacingLabel" android:layout_width="44dp" android:layout_height="wrap_content" android:textSize="16sp" android:gravity="end"/>
            </LinearLayout>

        </LinearLayout>

        <View android:id="@+id/divider1" android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="28dp" android:layout_marginEnd="28dp"/>

        <!-- ── Typography ── -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="28dp" android:paddingTop="28dp" android:paddingBottom="24dp">

            <TextView android:id="@+id/labelTypography" style="@style/SectionLabel" android:text="@string/ui_typography"/>

            <LinearLayout android:id="@+id/rowFont" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="12dp" android:background="?attr/selectableItemBackground">

                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/ui_font" android:textSize="17sp"/>

                <TextView android:id="@+id/fontValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="15sp"/>
            </LinearLayout>

            <LinearLayout android:id="@+id/rowWeight" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="12dp" android:background="?attr/selectableItemBackground">

                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/ui_weight" android:textSize="17sp"/>

                <TextView android:id="@+id/weightValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="15sp"/>
            </LinearLayout>

            <LinearLayout android:id="@+id/rowAlignment" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="12dp" android:background="?attr/selectableItemBackground">

                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/ui_alignment" android:textSize="17sp"/>

                <TextView android:id="@+id/alignmentValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="15sp"/>
            </LinearLayout>

            <LinearLayout android:id="@+id/rowFolderStyle" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="12dp" android:background="?attr/selectableItemBackground">

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_folder_style" android:textSize="17sp"/>

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_how_folder_labels_appear_on_the_home_screen" android:textSize="13sp" android:alpha="0.6"/>
                </LinearLayout>

                <TextView android:id="@+id/folderStyleValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="15sp"/>
            </LinearLayout>

        </LinearLayout>

        <View android:id="@+id/divider1b" android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="28dp" android:layout_marginEnd="28dp"/>

        <!-- ── Colors ── -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="28dp" android:paddingTop="28dp" android:paddingBottom="24dp">

            <TextView android:id="@+id/labelColors" style="@style/SectionLabel" android:text="@string/ui_colors"/>

            <!-- Background row - tap to open picker -->
            <LinearLayout android:id="@+id/rowBgColor" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="12dp" android:layout_marginBottom="4dp" android:background="?attr/selectableItemBackground">

                <TextView android:id="@+id/labelBg" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/ui_background" android:textSize="17sp"/>

                <View android:id="@+id/bgColorSwatch" android:layout_width="36dp" android:layout_height="36dp" android:layout_marginEnd="12dp"/>

                <TextView android:id="@+id/bgColorDisplay" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="15sp" android:fontFamily="monospace"/>
            </LinearLayout>

            <!-- App text row - tap to open picker -->
            <LinearLayout android:id="@+id/rowTextColor" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="12dp" android:background="?attr/selectableItemBackground">

                <TextView android:id="@+id/labelText" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/ui_app_text" android:textSize="17sp"/>

                <View android:id="@+id/textColorSwatch" android:layout_width="36dp" android:layout_height="36dp" android:layout_marginEnd="12dp"/>

                <TextView android:id="@+id/textColorDisplay" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="15sp" android:fontFamily="monospace"/>
            </LinearLayout>

            <!-- Preset color combinations -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_presets" android:textSize="11sp" android:textAllCaps="true" android:letterSpacing="0.15" android:textStyle="bold" android:alpha="0.5" android:layout_marginTop="16dp" android:layout_marginBottom="10dp"/>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">

                <TextView android:id="@+id/preset1" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:layout_marginEnd="8dp" android:text="@string/ui_aa" android:gravity="center" android:textSize="17sp" android:textStyle="bold"/>

                <TextView android:id="@+id/preset2" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:layout_marginEnd="8dp" android:text="@string/ui_aa" android:gravity="center" android:textSize="17sp" android:textStyle="bold"/>

                <TextView android:id="@+id/preset3" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:layout_marginEnd="8dp" android:text="@string/ui_aa" android:gravity="center" android:textSize="17sp" android:textStyle="bold"/>

                <TextView android:id="@+id/preset4" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:text="@string/ui_aa" android:gravity="center" android:textSize="17sp" android:textStyle="bold"/>

            </LinearLayout>

            <!-- Apply to lockscreen toggle -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="10dp" android:layout_marginTop="12dp">

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_apply_to_lockscreen" android:textSize="17sp"/>

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_fills_your_lockscreen_with_the_same_solid_color_" android:textSize="13sp" android:alpha="0.6"/>
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/switchSyncToLockscreen" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>

            <!-- Follow system theme toggle -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="10dp">

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_follow_system_theme" android:textSize="17sp"/>

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_switch_colors_with_system_dark_mode" android:textSize="13sp" android:alpha="0.6"/>
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/switchFollowSystemTheme" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>

        </LinearLayout>

        <View android:id="@+id/divider4" android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="28dp" android:layout_marginEnd="28dp"/>

        <!-- ── Gestures ── -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="28dp" android:paddingTop="28dp" android:paddingBottom="24dp">

            <TextView android:id="@+id/labelGestures" style="@style/SectionLabel" android:text="@string/ui_gestures"/>

            <!-- Directional gesture rows - populated programmatically -->
            <LinearLayout android:id="@+id/gesturesContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>

        </LinearLayout>

        <View android:id="@+id/divider2" android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="28dp" android:layout_marginEnd="28dp"/>

        <View android:id="@+id/divider3" android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="28dp" android:layout_marginEnd="28dp"/>

        <View android:id="@+id/divider3b" android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="28dp" android:layout_marginEnd="28dp"/>

        <!-- ── App shortcuts ── -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="28dp" android:paddingTop="28dp" android:paddingBottom="24dp">

            <TextView style="@style/SectionLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_app_shortcuts"/>

            <LinearLayout android:id="@+id/rowAddShortcutToAppList" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="14dp" android:background="?attr/selectableItemBackground">

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_add_to_application_list" android:textSize="17sp"/>

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_pin_another_app_s_shortcut_as_an_entry_in_your_a" android:textSize="13sp" android:alpha="0.6"/>
                </LinearLayout>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="→" android:textSize="17sp"/>
            </LinearLayout>

        </LinearLayout>

        <View android:id="@+id/divider3c" android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="28dp" android:layout_marginEnd="28dp"/>

        <View android:id="@+id/divider3d" android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="28dp" android:layout_marginEnd="28dp"/>

        <!-- ── Backup ── -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="28dp" android:paddingTop="28dp" android:paddingBottom="24dp">

            <TextView android:id="@+id/labelBackup" style="@style/SectionLabel" android:text="@string/ui_backup"/>

            <LinearLayout android:id="@+id/rowExportBackup" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="14dp" android:background="?attr/selectableItemBackground">

                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/ui_export_settings" android:textSize="17sp"/>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="→" android:textSize="17sp"/>
            </LinearLayout>

            <LinearLayout android:id="@+id/rowImportBackup" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="14dp" android:background="?attr/selectableItemBackground">

                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/ui_import_settings" android:textSize="17sp"/>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="→" android:textSize="17sp"/>
            </LinearLayout>

            <!-- Include hidden apps + PIN + biometric in backups. Off by default; toggling on
                 shows a consent dialog explaining the privacy trade-off. -->
            <LinearLayout android:id="@+id/rowIncludePrivateInBackup" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="14dp" android:background="?attr/selectableItemBackground">

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_include_hidden_apps_in_backups" android:textSize="17sp"/>

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_off_by_default_backups_skip_your_hidden_apps_pin" android:textSize="13sp" android:alpha="0.6"/>
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/switchIncludePrivateInBackup" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>

        </LinearLayout>

        <View android:id="@+id/divider5" android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="28dp" android:layout_marginEnd="28dp"/>

        <!-- ── Security ── -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="28dp" android:paddingTop="28dp" android:paddingBottom="24dp">

            <TextView style="@style/SectionLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_security"/>

            <!-- Master toggle: Hidden apps security -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="10dp">

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_lock_hidden_apps" android:textSize="17sp"/>

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_require_pin_to_view_or_unhide_apps" android:textSize="13sp" android:alpha="0.6"/>
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/switchHiddenAppsSecurity" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>

            <!-- Sub-row: Use biometric -->
            <LinearLayout android:id="@+id/rowBiometric" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="10dp" android:paddingStart="16dp" android:visibility="gone">

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_use_biometric" android:textSize="17sp"/>

                    <TextView android:id="@+id/labelBiometricSub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_unlock_with_fingerprint_or_face_pin_remains_as_f" android:textSize="13sp" android:alpha="0.6"/>
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/switchBiometric" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>

            <LinearLayout android:id="@+id/rowChangePin" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="12dp" android:background="?attr/selectableItemBackground" android:visibility="gone">

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_change_pin" android:textSize="17sp"/>

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_verify_current_pin_then_set_a_new_one" android:textSize="13sp" android:alpha="0.6"/>
                </LinearLayout>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="→" android:textSize="17sp"/>
            </LinearLayout>

            <!--
              Keep hidden apps in Recents. Unlike the three rows above this one WEAKENS a
              privacy behaviour, and it applies to hidden apps whether or not the PIN lock is
              on, so it is always visible and is not part of applyVisibility()'s gate.
            -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="10dp">

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_keep_hidden_apps_in_recents" android:textSize="17sp"/>

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_stops_android_closing_them_when_you_switch_away_" android:textSize="13sp" android:alpha="0.6"/>
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/switchKeepHiddenInRecents" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="10dp">

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_lock_long_press_menus_on_homescreen" android:textSize="17sp"/>

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_require_pin_to_open_them_biometric_isn_t_used_he" android:textSize="13sp" android:alpha="0.6"/>
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/switchLockLongPressMenus" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>

        </LinearLayout>

        <View android:id="@+id/divider6" android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="28dp" android:layout_marginEnd="28dp"/>

        <!-- ── About ── -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="28dp" android:paddingTop="28dp" android:paddingBottom="40dp">

            <TextView style="@style/SectionLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_about"/>

            <!-- Show guided tour -->
            <LinearLayout android:id="@+id/rowGuidedTour" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="12dp" android:background="?attr/selectableItemBackground">

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_show_guided_tour" android:textSize="17sp"/>

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_walk_through_the_launcher_s_gestures_and_feature" android:textSize="13sp" android:alpha="0.6"/>
                </LinearLayout>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="→" android:textSize="17sp"/>
            </LinearLayout>

            <!-- GitHub row -->
            <LinearLayout android:id="@+id/rowGithub" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="12dp" android:background="?attr/selectableItemBackground">

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_source_license" android:textSize="17sp"/>

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_github_com_roufsyed_slate_minimal_launcher" android:textSize="13sp" android:alpha="0.6"/>
                </LinearLayout>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="→" android:textSize="17sp"/>
            </LinearLayout>

            <!-- Version (read-only) -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="10dp">

                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/ui_version" android:textSize="17sp"/>

                <TextView android:id="@+id/labelAppVersion" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="15sp"/>
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>
</ScrollView>
