<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:id="@+id/onboardingRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="32dp"
        android:paddingTop="80dp"
        android:paddingBottom="32dp"
        android:gravity="center_horizontal">

        <!-- ── Branding ── -->

        <TextView
            android:id="@+id/labelAppName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/wordmark"
            android:textSize="56sp"
            android:textColor="#FFFFFF"
            android:fontFamily="sans-serif-light"
            android:letterSpacing="-0.03" />

        <TextView
            android:id="@+id/labelTagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/onboarding_tagline"
            android:textSize="15sp"
            android:textColor="#666666"
            android:letterSpacing="0.05" />

        <!-- ── Theme selection ── -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:layout_marginBottom="16dp"
            android:text="@string/onboarding_choose_a_theme"
            android:textSize="11sp"
            android:textColor="#555555"
            android:textAllCaps="true"
            android:letterSpacing="0.15"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <!-- Dark theme card -->
            <LinearLayout
                android:id="@+id/cardDark"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:orientation="vertical"
                android:padding="20dp"
                android:minHeight="200dp">

                <TextView
                    android:id="@+id/labelDark"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/onboarding_dark"
                    android:textSize="11sp"
                    android:textColor="#8888FF"
                    android:textAllCaps="true"
                    android:letterSpacing="0.15"
                    android:textStyle="bold"
                    android:layout_marginBottom="24dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/onboarding_sample_messages"
                    android:textSize="20sp"
                    android:textColor="#808080" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/onboarding_sample_maps"
                    android:textSize="16sp"
                    android:textColor="#808080"
                    android:layout_marginTop="10dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/onboarding_sample_camera"
                    android:textSize="14sp"
                    android:textColor="#808080"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/onboarding_sample_photos"
                    android:textSize="13sp"
                    android:textColor="#808080"
                    android:layout_marginTop="7dp" />

            </LinearLayout>

            <!-- Light theme card -->
            <LinearLayout
                android:id="@+id/cardLight"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:orientation="vertical"
                android:padding="20dp"
                android:minHeight="200dp">

                <TextView
                    android:id="@+id/labelLight"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/onboarding_light"
                    android:textSize="11sp"
                    android:textColor="#333399"
                    android:textAllCaps="true"
                    android:letterSpacing="0.15"
                    android:textStyle="bold"
                    android:layout_marginBottom="24dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/onboarding_sample_messages"
                    android:textSize="20sp"
                    android:textColor="#333333" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/onboarding_sample_maps"
                    android:textSize="16sp"
                    android:textColor="#333333"
                    android:layout_marginTop="10dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/onboarding_sample_camera"
                    android:textSize="14sp"
                    android:textColor="#333333"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/onboarding_sample_photos"
                    android:textSize="13sp"
                    android:textColor="#333333"
                    android:layout_marginTop="7dp" />

            </LinearLayout>

        </LinearLayout>

        <!-- ── Layout selection ── -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp"
            android:text="@string/onboarding_choose_a_layout"
            android:textSize="11sp"
            android:textColor="#555555"
            android:textAllCaps="true"
            android:letterSpacing="0.15"
            android:textStyle="bold" />

        <!--
          Both cards are coloured in code with whichever theme is selected above, so no text
          colour is set here. match_parent heights make the row equalise the pair, which the
          theme cards get from a shared minHeight instead.
        -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <!-- Flow card: a wrapping, centred paragraph whose names differ in size -->
            <LinearLayout
                android:id="@+id/cardFlow"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingVertical="16dp">

                <TextView
                    android:id="@+id/labelFlow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/onboarding_flow"
                    android:textSize="11sp"
                    android:textAllCaps="true"
                    android:letterSpacing="0.15"
                    android:textStyle="bold"
                    android:layout_marginBottom="14dp" />

                <!-- Wrap and alignment are set in code, mirroring renderFlowMode. -->
                <com.google.android.flexbox.FlexboxLayout
                    android:id="@+id/previewFlow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="4dp"
                        android:paddingVertical="1dp"
                        android:text="@string/onboarding_sample_mail"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="4dp"
                        android:paddingVertical="1dp"
                        android:text="@string/onboarding_sample_maps"
                        android:textSize="17sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="4dp"
                        android:paddingVertical="1dp"
                        android:text="@string/onboarding_sample_web"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="4dp"
                        android:paddingVertical="1dp"
                        android:text="@string/onboarding_sample_camera"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="4dp"
                        android:paddingVertical="1dp"
                        android:text="@string/onboarding_sample_clock"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="4dp"
                        android:paddingVertical="1dp"
                        android:text="@string/onboarding_sample_files"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="4dp"
                        android:paddingVertical="1dp"
                        android:text="@string/onboarding_sample_phone"
                        android:textSize="12sp" />

                </com.google.android.flexbox.FlexboxLayout>

                <TextView
                    android:id="@+id/captionFlow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:text="@string/onboarding_names_grow_with_use"
                    android:textSize="10sp"
                    android:alpha="0.7" />

            </LinearLayout>

            <!-- Minimal List card: one name per line, left-aligned, one size -->
            <LinearLayout
                android:id="@+id/cardList"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingVertical="16dp">

                <TextView
                    android:id="@+id/labelList"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/onboarding_minimal_list"
                    android:textSize="11sp"
                    android:textAllCaps="true"
                    android:letterSpacing="0.15"
                    android:textStyle="bold"
                    android:layout_marginBottom="14dp" />

                <LinearLayout
                    android:id="@+id/previewList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/onboarding_sample_mail"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/onboarding_sample_maps"
                        android:textSize="14sp"
                        android:layout_marginTop="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/onboarding_sample_web"
                        android:textSize="14sp"
                        android:layout_marginTop="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/onboarding_sample_camera"
                        android:textSize="14sp"
                        android:layout_marginTop="4dp" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- ── Spacer ── -->
        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- ── Privacy policy consent (gates all three exit paths) ── -->

        <LinearLayout
            android:id="@+id/rowPrivacyCheck"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="32dp">

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/checkPrivacy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="#8888FF"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:paddingStart="0dp"
                android:contentDescription="@string/onboarding_privacy_checkbox_description" />

            <TextView
                android:id="@+id/labelPrivacyAcceptance"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="14sp"
                android:textColor="#999999"
                android:layout_marginStart="6dp"
                android:lineSpacingMultiplier="1.3"
                android:labelFor="@+id/checkPrivacy" />
        </LinearLayout>

        <!-- ── Actions ── -->

        <TextView
            android:id="@+id/btnSetDefault"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/onboarding_set_as_default_launcher"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:paddingVertical="16dp"
            android:background="@android:color/transparent" />

        <TextView
            android:id="@+id/btnSkip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/onboarding_skip_for_now"
            android:textSize="14sp"
            android:textColor="#555555"
            android:gravity="center"
            android:paddingVertical="14dp" />

        <!-- ── Returning user ── -->

        <View
            android:layout_width="48dp"
            android:layout_height="1dp"
            android:layout_marginVertical="12dp"
            android:background="#222222" />

        <TextView
            android:id="@+id/btnImportSettings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/onboarding_import_previous_settings"
            android:textSize="14sp"
            android:textColor="#8888FF"
            android:gravity="center"
            android:paddingVertical="12dp" />

        <TextView
            android:id="@+id/labelImportHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/onboarding_restore_from_a_slate_backup_json"
            android:textSize="12sp"
            android:textColor="#444444"
            android:gravity="center" />

    </LinearLayout>

</ScrollView>
